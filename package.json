{
  "name": "tunjik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:content && tsc -b && vite build",
    "build:android": "DEPLOY_BASE_PATH=./ npm run build",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "validate:content": "tsx scripts/validate-content.ts",
    "import:lexicon": "tsx scripts/import-lexicon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "i18next": "^25.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.3.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@fontsource/noto-serif-armenian": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
